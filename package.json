{
  "name": "react-native-advance-modal",
  "version": "1.0.7",
  "description": "A lightweight, customizable, and animated modal component for React Native.",
  "keywords": [
    "react-native",
    "react native modal",
    "react-native-modal",
    "modal component",
    "animated modal",
    "react native popup",
    "react native dialog",
    "bottom sheet",
    "react native ui",
    "typescript"
  ],
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rm -rf dist && tsc",
    "patchpublish": "npm version patch && npm publish && git push --follow-tags",
    "watch": "tsc --watch & nodemon --watch dist --exec \"yalc push\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mukthahar26/react-native-advance-modal.git"
  },
  "bugs": {
    "url": "https://github.com/Mukthahar26/react-native-advance-modal/issues"
  },
  "homepage": "https://github.com/Mukthahar26/react-native-advance-modal",
  "author": "Mukthahar Shaik",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-native": "^0.73.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.7.2"
  }
}
