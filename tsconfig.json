{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2017",
    "module": "CommonJS",
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "index.ts"]
}
